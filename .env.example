# Copy to .env on the deployment host. Keep .env out of source control.
RECON_DOMAIN=reconcile.example.com
RECON_ADMIN_EMAIL=admin@example.com
RECON_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
RECON_SECRET=replace-with-at-least-32-random-characters
RECON_MFA_KEY=replace-with-a-separate-stable-32-character-random-secret
RECON_REQUIRE_MFA=1
# Archive key: a separate base64-encoded 32-byte value, stored in your secret manager.
# RECON_ARCHIVE_KEY=
# RECON_ARCHIVE_S3_BUCKET=
# RECON_ARCHIVE_KMS_KEY=
# RECON_SMTP_HOST=
# RECON_SMTP_PORT=587
# RECON_SMTP_FROM=
# RECON_SMTP_USER=
# RECON_SMTP_PASSWORD=
