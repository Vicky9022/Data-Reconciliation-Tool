{
  "title":"Reconcile service operations","uid":"reconcile-service","schemaVersion":40,"version":1,"refresh":"30s",
  "time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"title":"Runs by state","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"reconcile_runs","legendFormat":"{{state}}"}]},
    {"id":2,"title":"Free storage (bytes)","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"reconcile_disk_free_bytes"}]},
    {"id":3,"title":"Mean completed processing time (seconds)","type":"stat","gridPos":{"x":0,"y":8,"w":12,"h":5},"targets":[{"expr":"reconcile_run_duration_seconds_sum / clamp_min(reconcile_run_duration_seconds_count, 1)"}]},
    {"id":4,"title":"Coordinator heartbeat age (seconds)","type":"stat","gridPos":{"x":12,"y":8,"w":12,"h":5},"targets":[{"expr":"reconcile_worker_heartbeat_age_seconds"}]}
  ]
}
